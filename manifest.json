{
  "manifest_version": 3,
  "name": "EYROVE Prompt Lite",
  "short_name": "EYROVE Lite",
  "version": "0.1.0",
  "description": "Open-source BYOK image prompt reverse, local color palette and translation. No image generation.",
  "homepage_url": "https://github.com/geslie1/eyrove-prompt-lite",
  "permissions": [
    "contextMenus",
    "permissions",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EYROVE Prompt Lite",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
